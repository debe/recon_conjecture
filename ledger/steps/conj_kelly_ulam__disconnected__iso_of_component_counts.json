{
  "id": "conj_kelly_ulam__disconnected__iso_of_component_counts",
  "program": "conj",
  "title": "Equal component counts imply isomorphism",
  "statement_en": "Two graphs on n vertices with the same number of connected components isomorphic to each connected graph F are isomorphic.",
  "statement_lean": "∀ n : ℕ, ∀ G H : SimpleGraph (Fin n), (∀ k : ℕ, ∀ F : SimpleGraph (Fin k), F.Connected → {c : G.ConnectedComponent | Nonempty (G.induce c.supp ≃g F)}.ncard = {c : H.ConnectedComponent | Nonempty (H.induce c.supp ≃g F)}.ncard) → Nonempty (G ≃g H)",
